# Dependencies and build output — reinstallable, and 100M+ of churn.
node_modules/
dist/

# A live Chrome user-data directory that lives inside the project (135M). Its
# Default/ subtree holds cookies, login data and history, so this is credential
# material, not build junk — it must never reach a remote, private or not.
chrome-profile/

# Bundled eval harness. Regenerated by `npm run measure` on every run, and the
# chunk filenames are content-hashed, so committing it is pure churn.
.eval/build/

# `.eval/measurements.json` is deliberately NOT ignored. It is the measured grid
# that every balance number in ARCHITECTURE.md and ENDGAME.md is quoted from, and
# reproducing it costs a twenty-minute run — the docs do not make sense without it.

# Local, per-machine tool settings.
.claude/settings.local.json

# macOS and editor noise.
.DS_Store
*.log
