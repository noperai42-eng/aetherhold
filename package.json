{
  "name": "aetherhold",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aetherhold — a colony sim you can also walk around inside. Dual-view: manager overhead + first-person colonist.",
  "scripts": {
    "dev": "vite",
    "play": "vite preview",
    "ship": "npm run build && echo 'Shipped to the play server. Players pick it up on their next reload — nobody is kicked out mid-game.'",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "vitest run tests/colony-eval.test.ts --disableConsoleIntercept",
    "test:watch": "vitest",
    "look": "node scripts/look/shot.mjs",
    "look:zoo": "node scripts/look/zoo.mjs",
    "look:crew": "node scripts/look/crew.mjs",
    "look:heads": "node scripts/look/heads.mjs",
    "look:trouble": "node scripts/look/trouble.mjs",
    "look:setup": "cd scripts/look && npm install && npx @puppeteer/browsers install chrome@stable --path \"$HOME/.cache/puppeteer\"",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "build:tools": "rolldown src/tools/export-models.ts --format esm --platform node -d .tools/build",
    "export:models": "npm run build:tools && node .tools/build/export-models.js",
    "sweep": "SWEEP=1 vitest run tests/survival-sweep.test.ts --disableConsoleIntercept",
    "build:eval": "rolldown src/eval/measure.ts src/eval/worker.ts --format esm --platform node -d .eval/build",
    "measure": "npm run build:eval && node .eval/build/measure.js",
    "balance": "BALANCE=1 vitest run tests/balance-grid.test.ts --disableConsoleIntercept",
    "pool": "npm run build:eval && POOL=1 vitest run tests/eval-pool.test.ts --disableConsoleIntercept",
    "eco": "ECO=1 vitest run tests/ecosystem.test.ts --disableConsoleIntercept",
    "live": "LIVE=1 vitest run tests/liveness.test.ts --disableConsoleIntercept"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "rolldown": "^1.1.5",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
